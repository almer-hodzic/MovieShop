{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "[{Application}][{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithProcessId", "WithMachineName" ]
  },
  "ConnectionStrings": {
    "Main": "Server=localhost;Database=MovieShopDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Market.Api",
    "Audience": "Market.Spa",
    "Key": "DEV_ONLY_CHANGE_ME_TO_LONG_RANDOM_SECRET",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "PayPal": {
    "ClientId": "REPLACE_WITH_PAYPAL_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_PAYPAL_CLIENT_SECRET",
    "Mode": "sandbox",
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "CurrencyCode": "USD"
  },
  "Email": {
    "ApiKey": "REPLACE_WITH_SENDGRID_API_KEY",
    "FromEmail": "al1merr248@gmail.com",
    "FromName": "MovieShop",
    "FrontendBaseUrl": "http://localhost:4200"
  }
}
